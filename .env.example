# Required for OpenRouter-generated Concept Packs and rehearsal chat.
OPENROUTER_API_KEY=your_openrouter_api_key

# OPENROUTER_MODEL: Optional model; openrouter/free selects a free capable model.
OPENROUTER_MODEL=your_openrouter_model

# APP_URL: The URL where this applet is hosted.
APP_URL=your_app_url

# Stronger model runs once per validated lesson context and its pack is cached.
OPENROUTER_CONCEPT_PACK_MODEL=your_openrouter_concept_pack_model

# Lower-cost model for rehearsal chat and short mentor-feedback drafts.
OPENROUTER_REHEARSAL_MODEL=your_openrouter_rehearsal_model

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CONCEPT_PACK_MODEL=your_gemini_concept_pack_model
GEMINI_REHEARSAL_MODEL=your_gemini_rehearsal_model
# Enable optional Phase 2 classroom clip consent in the client and server.
VITE_BANSAY_PHASE_2=false
